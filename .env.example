# NNC Reporter settings. Copy to .env for running on your own computer (.env is
# git-ignored and never committed). On a server, set these in the host's secret
# store or env file instead - never in the repository.

# ---- The address people use (needed for links in emails, and secure cookies)
NNC_BASE_URL=https://reports.example.org
# Encrypts the council passwords people save. 32+ random characters, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NNC_SECRET_KEY=

# ---- Email, for invitations and password resets (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NNC Reporter <reports@example.org>

# ---- Sign-in policy
# Two-factor sign-in: required for "admins" (default), "all", or "none"
NNC_MFA_REQUIRED=admins
NNC_PASSWORD_MIN_LENGTH=12
# Refuse passwords found in known breaches (Have I Been Pwned, k-anonymity)
NNC_HIBP_CHECK=1
NNC_SESSION_IDLE_MINUTES=120
NNC_SESSION_MAX_HOURS=12

# ---- Mapbox. The SECRET token stays on the server; browsers get short-lived
# tokens minted from it. It needs the tokens:write scope.
MAPBOX_SECRET_TOKEN=
# Optional fallback: a PUBLIC token restricted to NNC_BASE_URL in Mapbox.
MAPBOX_PUBLIC_TOKEN=

# ---- Shared API keys (optional - features degrade without them)
ANTHROPIC_API_KEY=
WHAT3WORDS_API_KEY=
# Contact address sent to OpenStreetMap's Nominatim with each street lookup
NNC_NOMINATIM_EMAIL=

# ---- Submitting to the council
# server  = forms are filled on the server; each person approves each one (default)
# visible = a browser window opens on this computer (desktop use only)
NNC_SUBMIT_MODE=server
# How many headless browsers may run at once (~1GB memory each)
NNC_MAX_BROWSERS=2

# ---- First admin: invited automatically on first start if there are no accounts
# (the link is printed in the server log and emailed if SMTP is set)
NNC_BOOTSTRAP_ADMIN=

# ---- Where data lives (accounts, reports, photos). Back this folder up.
# NNC_DATA_DIR=/data
# NNC_HOST=127.0.0.1
# PORT=8712
